<Window x:Class="ControlBoxForCustom.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlBoxForCustom.Demo"
        xmlns:cbfc="clr-namespace:ControlBoxForCustom;assembly=ControlBoxForCustom"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      GlassFrameThickness="-1, -1, -1, -1"
                      ResizeBorderThickness="1"
                      UseAeroCaptionButtons="True"
                      CornerRadius="1"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <!--タイトルバー領域-->
            <RowDefinition Height="32"/>
            <!--コンテンツ領域-->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="TitleBar" Grid.Row="0" Background="Aqua" Padding="12,0">
            <DockPanel LastChildFill="False" Margin="0,0,-12,0">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="White"
                           FontSize="13"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <cbfc:CaptionMinimizeButton Background="Gray" Foreground="White" Width="40" />
                    <cbfc:CaptionMaximizeButton Background="Gray" Foreground="White" Width="40" />
                    <cbfc:CaptionCloseButton Background="Gray" Foreground="White" Width="40" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
